<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:visuals="clr-namespace:OsuPlayer.Views.CustomControls"
             xmlns:views="clr-namespace:OsuPlayer.Views"
             mc:Ignorable="d"
             d:DesignWidth="1400" d:DesignHeight="820"
             x:Class="OsuPlayer.Views.NowPlayingView"
             FontWeight="{DynamicResource DefaultFontWeight}">

    <UserControl.Styles>
        <StyleInclude Source="/Styles/SliderStyle.axaml" />

        <Style Selector="Button.player-control">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Button.player-control:pointerover">
            <Setter Property="Background" Value="#3DFFFFFF" />
            <Setter Property="BorderBrush" Value="#68FFFFFF" />
        </Style>

        <Style Selector="Button.play-control">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="68" />
            <Setter Property="CornerRadius" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Button.play-control:pointerover">
            <Setter Property="Opacity" Value="0.88" />
        </Style>

        <Style Selector="Button.overlay-action">
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#2BFFFFFF" />
            <Setter Property="BorderBrush" Value="#38FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.overlay-action:pointerover">
            <Setter Property="Background" Value="#45FFFFFF" />
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <views:NowPlayingViewModel />
    </Design.DataContext>

    <Grid x:Name="NowPlayingRoot" Background="#071014" ClipToBounds="True"
          PointerMoved="NowPlayingRoot_OnPointerMoved" PointerExited="NowPlayingRoot_OnPointerExited">
        <Image Source="{Binding BackgroundImage}"
               Stretch="UniformToFill"
               Opacity="0.88"
               IsHitTestVisible="False" />

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#40071014" Offset="0" />
                    <GradientStop Color="#78071014" Offset="0.62" />
                    <GradientStop Color="#D8071014" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <visuals:AmbientParticleControl IsActive="{Binding IsPlaying}" ParticleCount="{Binding ParticleCount}"
                                        Opacity="0.86" />

        <Grid x:Name="ImmersiveStage" Margin="{Binding PageMargin}" RowDefinitions="Auto,*,Auto"
              RenderTransformOrigin="50%,50%" RenderTransform="scale(1)">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.26" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" />
                </Transitions>
            </Grid.Transitions>

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Spacing="2" IsVisible="{Binding IsNotImmersive}">
                    <TextBlock Text="NOW PLAYING" FontSize="12" LetterSpacing="2.8"
                               Foreground="{Binding AccentBrush}" />
                    <TextBlock Text="osu!player elite" FontSize="14" Foreground="#8CFFFFFF"
                               FontWeight="{DynamicResource SmallerFontWeight}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Border Padding="12,6" CornerRadius="16" IsVisible="{Binding IsNotImmersive}"
                            Background="#1FFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="{Binding AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="LOCAL LIBRARY" FontSize="11" LetterSpacing="1.2"
                                       Foreground="#BFFFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Classes="overlay-action" IsVisible="{Binding IsNotImmersive}"
                            Click="EnterImmersive_OnClick" ToolTip.Tip="Immersive fullscreen">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:MaterialIcon Kind="Fullscreen" Width="20" Height="20" />
                            <TextBlock Text="FULLSCREEN" FontSize="11" LetterSpacing="1.1" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid Width="{Binding SpectrumSize}" Height="{Binding SpectrumSize}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{Binding SpectrumMargin}">
                    <visuals:CircularSpectrumControl Width="{Binding SpectrumSize}" Height="{Binding SpectrumSize}"
                                                     AudioEngine="{Binding AudioEngine}"
                                                     IsActive="{Binding IsPlaying}"
                                                     ArtworkDiameter="{Binding ArtworkSize}"
                                                     AccentBrush="{Binding AccentBrush}" />

                    <visuals:CircularProgressRingControl Width="{Binding SpectrumSize}" Height="{Binding SpectrumSize}"
                                                         SongPosition="{Binding SongTime}"
                                                         SongLength="{Binding SongLength}"
                                                         ArtworkDiameter="{Binding ArtworkSize}"
                                                         AccentBrush="{Binding AccentBrush}" />

                    <Grid Width="{Binding ArtworkSize}" Height="{Binding ArtworkSize}" HorizontalAlignment="Center">
                        <Ellipse x:Name="PlaceholderArtwork" Width="{Binding ArtworkSize}" Height="{Binding ArtworkSize}" Fill="#15252B2E">
                            <Ellipse.RenderTransform>
                                <RotateTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <Ellipse x:Name="CoverArtwork" Width="{Binding ArtworkSize}" Height="{Binding ArtworkSize}">
                            <Ellipse.Fill>
                                <ImageBrush Source="{Binding CurrentSongImage}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <RotateTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <Ellipse Width="{Binding CenterHoleSize}" Height="{Binding CenterHoleSize}" Fill="#E6071014"
                                 Stroke="#4DFFFFFF" StrokeThickness="1" />
                        <Ellipse Width="12" Height="12" Fill="{Binding AccentBrush}" />

                        <Border MaxWidth="{Binding ArtworkTextWidth}" Padding="16,10"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#52051014" CornerRadius="12">
                            <StackPanel HorizontalAlignment="Stretch" Spacing="4">
                                <TextBlock Text="{Binding TitleText}" FontFamily="Montserrat" FontSize="17"
                                           LetterSpacing="0.35" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch"
                                           Foreground="White" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ArtistText}" FontFamily="Montserrat" FontSize="12"
                                           LetterSpacing="0.5" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch"
                                           Foreground="#D0FFFFFF" FontWeight="Medium" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="LyricsCarousel" Width="{Binding LyricsPanelWidth}"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                      RenderTransformOrigin="50%,50%" RenderTransform="translate(0px, 0px)">
                    <Grid.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.20" />
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" />
                        </Transitions>
                    </Grid.Transitions>

                    <StackPanel Spacing="4" IsVisible="{Binding HasSynchronizedLyrics}">
                        <TextBlock Text="{Binding PreviousLyricText}" FontFamily="Montserrat"
                                   FontSize="{Binding ContextLyricFontSize}" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="#52FFFFFF" />
                        <TextBlock Text="{Binding CurrentLyricText}" FontFamily="Montserrat"
                                   FontSize="{Binding CurrentLyricFontSize}" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                   Foreground="{Binding AccentBrush}" />
                        <TextBlock Text="{Binding CurrentLyricTranslation}" FontFamily="Montserrat" FontSize="12"
                                   IsVisible="{Binding HasCurrentLyricTranslation}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                   Foreground="#A8FFFFFF" />
                        <TextBlock Text="{Binding NextLyricText}" FontFamily="Montserrat"
                                   FontSize="{Binding ContextLyricFontSize}" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="#70FFFFFF" />
                    </StackPanel>

                    <TextBlock Text="{Binding LyricsStatusText}" IsVisible="{Binding IsLyricsStatusVisible}"
                               FontFamily="Montserrat" FontSize="13" LetterSpacing="0.25"
                               TextAlignment="Center" Foreground="#8FFFFFFF" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" VerticalAlignment="Bottom">
                <Button Grid.Column="0" Classes="overlay-action" IsVisible="{Binding IsImmersive}"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,10"
                        Click="ExitImmersive_OnClick" ToolTip.Tip="Exit immersive mode (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:MaterialIcon Kind="ArrowBack" Width="19" Height="19" />
                        <TextBlock Text="EXIT FULLSCREEN" FontSize="11" LetterSpacing="1.1" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid Grid.Column="1" Width="{Binding ControlsWidth}" MaxWidth="860"
                      HorizontalAlignment="Center" RowDefinitions="Auto,Auto,Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                        <TextBlock Text="{Binding CurrentSongTime}" FontSize="12" Foreground="#A8FFFFFF" />
                        <TextBlock Grid.Column="2" Text="{Binding CurrentSongLength}" FontSize="12"
                                   Foreground="#A8FFFFFF" />
                    </Grid>

                    <Grid Grid.Row="1" Height="20">
                        <Border Height="4" CornerRadius="2" Background="#48FFFFFF"
                                VerticalAlignment="Center" IsHitTestVisible="False" />

                        <Slider x:Name="SongProgressSlider" Height="20"
                                Minimum="0" Maximum="{Binding SongLength}"
                                Value="{Binding SongTime}"
                                Foreground="{Binding AccentBrush}" Background="Transparent">
                            <Slider.Template>
                                <ControlTemplate>
                                    <Track Name="PART_Track" Orientation="Horizontal" Height="20">
                                        <Track.DecreaseButton>
                                            <RepeatButton Background="{Binding AccentBrush}">
                                                <RepeatButton.Template>
                                                    <ControlTemplate>
                                                        <Border Height="4" CornerRadius="2"
                                                                Background="{TemplateBinding Background}"
                                                                VerticalAlignment="Center" />
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseButton>
                                        <Track.IncreaseButton>
                                            <RepeatButton Background="Transparent">
                                                <RepeatButton.Template>
                                                    <ControlTemplate>
                                                        <Border Background="Transparent" />
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseButton>
                                        <Thumb Width="14" Height="14" Background="{Binding AccentBrush}">
                                            <Thumb.Template>
                                                <ControlTemplate>
                                                    <Grid>
                                                        <Ellipse Fill="#F2FFFFFF" />
                                                        <Ellipse Margin="3" Fill="{TemplateBinding Background}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track>
                                </ControlTemplate>
                            </Slider.Template>
                        </Slider>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                                Spacing="18" Margin="0,16,0,0">
                        <Button Classes="player-control" Click="Previous_OnClick" ToolTip.Tip="Previous">
                            <icons:MaterialIcon Kind="SkipBackward" Width="24" Height="24" />
                        </Button>
                        <Button Classes="play-control" Click="PlayPause_OnClick" ToolTip.Tip="Play / pause"
                                Background="{Binding AccentBrush}" Foreground="{Binding AccentForegroundBrush}">
                            <icons:MaterialIcon Kind="{Binding IsPlaying, Converter={StaticResource PlayPauseConverter}}"
                                                Width="34" Height="34" />
                        </Button>
                        <Button Classes="player-control" Click="Next_OnClick" ToolTip.Tip="Next">
                            <icons:MaterialIcon Kind="SkipForward" Width="24" Height="24" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="ParticleDensityDrawer" Width="64" Height="224" HorizontalAlignment="Right"
                VerticalAlignment="Center" Margin="0,0,18,0" Padding="10,12"
                Background="#BE0A151A" BorderBrush="#52FFFFFF" BorderThickness="1" CornerRadius="24"
                Opacity="0" RenderTransform="translate(86px, 0px)">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" />
                </Transitions>
            </Border.Transitions>
            <StackPanel HorizontalAlignment="Center" Spacing="7">
                <TextBlock Text="MORE" FontSize="9" LetterSpacing="1.1" Foreground="#AFFFFFFF"
                           HorizontalAlignment="Center" />
                <Slider Width="24" Height="128" Orientation="Vertical" Minimum="40" Maximum="280"
                        SmallChange="10" LargeChange="20" TickFrequency="20" TickPlacement="None"
                        Value="{Binding ParticleCount, Mode=TwoWay}" Foreground="{Binding AccentBrush}" />
                <TextBlock Text="LESS" FontSize="9" LetterSpacing="1.1" Foreground="#AFFFFFFF"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ParticleCount}" FontSize="11" Foreground="White"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <Rectangle x:Name="TransitionCurtain" Fill="#FF020608" Opacity="0" IsHitTestVisible="False">
            <Rectangle.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.24" />
                </Transitions>
            </Rectangle.Transitions>
        </Rectangle>
    </Grid>
</UserControl>
